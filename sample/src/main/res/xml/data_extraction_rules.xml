<?xml version="1.0" encoding="utf-8"?>
<!-- 示例应用无用户数据需要备份；宿主如需备份请参考 docs/INTEGRATION.md §6.3。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
